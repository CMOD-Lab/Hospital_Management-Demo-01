@page
@model ClinicManagement.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="card shadow">
            <div class="card-body py-5">
                <i class="fas fa-exclamation-triangle fa-5x text-danger mb-4"></i>
                <h3 class="text-danger">An Error Occurred</h3>
                <p class="text-muted">Sorry, something went wrong. Please try again later.</p>
                @if (Model.ShowRequestId)
                {
                    <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
                }
                <a href="/" class="btn btn-primary mt-3">
                    <i class="fas fa-home me-2"></i>Go to Home
                </a>
            </div>
        </div>
    </div>
</div>
