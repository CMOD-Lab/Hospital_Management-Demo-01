@page
@model ClinicManagement.Web.Pages.Doctor.HistoryUpdateModel
@{
    ViewData["Title"] = "Update History";
    Layout = "_DoctorLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-edit me-2"></i>Update Patient History</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="fas fa-calendar-day me-2"></i>Today's Appointments</h5>
    </div>
    <div class="card-body">
        @if (Model.TodaysAppointments.Any())
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Appointment ID</th>
                        <th>Patient Name</th>
                        <th>Timings</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.TodaysAppointments)
                    {
                        <tr>
                            <td>@appt.AppointmentId</td>
                            <td>@(appt.Patient?.Name ?? "N/A")</td>
                            <td>@appt.Timings</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-primary"
                                        onclick="selectAppointment(@appt.AppointmentId)">
                                    <i class="fas fa-edit me-1"></i>Update
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No appointments today.</p>
        }
    </div>
</div>

<div class="card shadow">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-prescription me-2"></i>Update Prescription</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label for="AppointmentId" class="form-label">Appointment ID *</label>
                <input type="number" class="form-control" id="AppointmentId" name="AppointmentId" required />
            </div>
            <div class="mb-3">
                <label for="Disease" class="form-label">Disease *</label>
                <input type="text" class="form-control" id="Disease" name="Disease" required maxlength="30" />
            </div>
            <div class="mb-3">
                <label for="Progress" class="form-label">Progress *</label>
                <input type="text" class="form-control" id="Progress" name="Progress" required maxlength="50" />
            </div>
            <div class="mb-3">
                <label for="Prescription" class="form-label">Prescription *</label>
                <textarea class="form-control" id="Prescription" name="Prescription" rows="3" required maxlength="60"></textarea>
            </div>
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save me-2"></i>Update Prescription
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function selectAppointment(id) {
            document.getElementById('AppointmentId').value = id;
            document.getElementById('AppointmentId').scrollIntoView({ behavior: 'smooth' });
        }
    </script>
}
