@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Generate Bills";
    Layout = "_DoctorLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-file-invoice-dollar me-2"></i>Generate Bills</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow">
    <div class="card-body">
        @if (Model.TodaysAppointments.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-success">
                    <tr>
                        <th>Appointment ID</th>
                        <th>Patient Name</th>
                        <th>Timings</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.TodaysAppointments)
                    {
                        <tr>
                            <td>@appt.AppointmentId</td>
                            <td>@(appt.Patient?.Name ?? "N/A")</td>
                            <td>@appt.Timings</td>
                            <td>
                                <form method="post" asp-page-handler="Paid" class="d-inline">
                                    <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                                    <button type="submit" class="btn btn-sm btn-success me-1">
                                        <i class="fas fa-check me-1"></i>Paid
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Unpaid" class="d-inline">
                                    <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                                    <button type="submit" class="btn btn-sm btn-warning">
                                        <i class="fas fa-times me-1"></i>Unpaid
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-file-invoice-dollar fa-3x text-muted mb-3"></i>
                <p class="text-muted">No appointments to bill today.</p>
            </div>
        }
    </div>
</div>
