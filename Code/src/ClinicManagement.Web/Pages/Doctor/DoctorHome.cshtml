@page
@model ClinicManagement.Web.Pages.Doctor.DoctorHomeModel
@{
    ViewData["Title"] = "Doctor Home";
    Layout = "_DoctorLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-stethoscope me-2"></i>Doctor Profile</h2>
        <hr />
    </div>
</div>

@if (Model.Doctor != null)
{
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow text-center">
                <div class="card-body">
                    <i class="fas fa-user-md fa-5x text-success mb-3"></i>
                    <h4>@Model.Doctor.Name</h4>
                    <p class="text-muted">@Model.Doctor.Specialization</p>
                    <span class="badge bg-success">Active</span>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Doctor Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Email:</strong> @Model.Doctor.Email</p>
                            <p><strong>Phone:</strong> @Model.Doctor.Phone</p>
                            <p><strong>Gender:</strong> @Model.Doctor.Gender</p>
                            <p><strong>Address:</strong> @Model.Doctor.Address</p>
                            <p><strong>Birth Date:</strong> @Model.Doctor.BirthDate.ToString("yyyy-MM-dd")</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Department:</strong> @(Model.Doctor.Department?.DeptName ?? "N/A")</p>
                            <p><strong>Qualification:</strong> @Model.Doctor.Qualification</p>
                            <p><strong>Experience:</strong> @Model.Doctor.Experience years</p>
                            <p><strong>Charges/Visit:</strong> $@Model.Doctor.ChargesPerVisit</p>
                            <p><strong>Repute Index:</strong> @Model.Doctor.ReputeIndex.ToString("F2")</p>
                            <p><strong>Patients Treated:</strong> @Model.Doctor.PatientsTreated</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/Doctor/PendingAppointment" class="btn btn-warning">
                            <i class="fas fa-clock me-2"></i>Pending Appointments
                        </a>
                        <a href="/Doctor/PatientHistory" class="btn btn-info text-white">
                            <i class="fas fa-history me-2"></i>Patient History
                        </a>
                        <a href="/Doctor/Bill" class="btn btn-success">
                            <i class="fas fa-file-invoice-dollar me-2"></i>Generate Bills
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle me-2"></i>There was some error retrieving doctor information.
    </div>
}
