@page
@model ClinicManagement.Web.Pages.Doctor.PendingAppointmentModel
@{
    ViewData["Title"] = "Pending Appointments";
    Layout = "_DoctorLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-clock me-2"></i>Pending Appointments</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow">
    <div class="card-body">
        @if (Model.PendingAppointments.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-warning">
                    <tr>
                        <th>Appointment ID</th>
                        <th>Patient Name</th>
                        <th>Timings</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.PendingAppointments)
                    {
                        <tr>
                            <td>@appt.AppointmentId</td>
                            <td>@(appt.Patient?.Name ?? "N/A")</td>
                            <td>@appt.Timings</td>
                            <td>@appt.AppointmentDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <form method="post" asp-page-handler="Approve" class="d-inline">
                                    <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                                    <button type="submit" class="btn btn-sm btn-success me-1">
                                        <i class="fas fa-check me-1"></i>Approve
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Delete" class="d-inline">
                                    <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this appointment?')">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                <p class="text-muted">No pending appointments at this time.</p>
            </div>
        }
    </div>
</div>
