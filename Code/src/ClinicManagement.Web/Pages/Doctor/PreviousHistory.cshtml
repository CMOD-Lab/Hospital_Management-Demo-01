@page
@model ClinicManagement.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Previous History";
    Layout = "_DoctorLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-history me-2"></i>Previous Patient History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.Appointments.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-secondary">
                    <tr>
                        <th>Appointment ID</th>
                        <th>Patient Name</th>
                        <th>Disease</th>
                        <th>Progress</th>
                        <th>Prescription</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.Appointments)
                    {
                        <tr>
                            <td>@appt.AppointmentId</td>
                            <td>@(appt.Patient?.Name ?? "N/A")</td>
                            <td>@(appt.Disease ?? "N/A")</td>
                            <td>@(appt.Progress ?? "N/A")</td>
                            <td>@(appt.Prescription ?? "N/A")</td>
                            <td>@appt.AppointmentDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-history fa-3x text-muted mb-3"></i>
                <p class="text-muted">No previous history available.</p>
            </div>
        }
    </div>
</div>
