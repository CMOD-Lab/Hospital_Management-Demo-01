<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedicX 4 Health Care</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-info">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Patient/PatientHome">
                <i class="fas fa-hospital-alt me-2"></i>MedicX 4 Health Care
            </a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link text-white" href="/Patient/PatientHome"><i class="fas fa-home me-1"></i>Home</a>
                <a class="nav-link text-white" href="/Patient/ViewDoctors"><i class="fas fa-user-md me-1"></i>Doctors</a>
                <a class="nav-link text-white" href="/Patient/CurrentAppointment"><i class="fas fa-calendar-check me-1"></i>Appointment</a>
                <a class="nav-link text-white" href="/Patient/TreatmentHistory"><i class="fas fa-history me-1"></i>History</a>
                <a class="nav-link text-white" href="/Patient/BillsHistory"><i class="fas fa-file-invoice me-1"></i>Bills</a>
                <a class="nav-link text-white" href="/Patient/PatientNotifications"><i class="fas fa-bell me-1"></i>Notifications</a>
                <a class="nav-link text-white" href="/SignUp"><i class="fas fa-sign-out-alt me-1"></i>Logout</a>
            </div>
        </div>
    </nav>

    <div class="container-fluid mt-4">
        @RenderBody()
    </div>

    <footer class="footer mt-auto py-3 bg-light">
        <div class="container text-center">
            <span class="text-muted">&copy; @DateTime.Now.Year - MedicX 4 Health Care | Patient Portal</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
