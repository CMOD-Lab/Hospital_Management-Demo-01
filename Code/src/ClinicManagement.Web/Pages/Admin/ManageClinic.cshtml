@page
@model ClinicManagement.Web.Pages.Admin.ManageClinicModel
@{
    ViewData["Title"] = "Manage Clinic";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-users me-2"></i>Manage Clinic</h2>
        <hr />
    </div>
</div>

<!-- Filter and Search -->
<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Category</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="category" id="catDoctor" value="DOCTOR"
                               @(Model.Category == "DOCTOR" ? "checked" : "") />
                        <label class="form-check-label" for="catDoctor">Doctors</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="category" id="catPatient" value="PATIENT"
                               @(Model.Category == "PATIENT" ? "checked" : "") />
                        <label class="form-check-label" for="catPatient">Patients</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="category" id="catStaff" value="STAFF"
                               @(Model.Category == "STAFF" ? "checked" : "") />
                        <label class="form-check-label" for="catStaff">Staff</label>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <label for="searchQuery" class="form-label">Search by Name</label>
                <input type="text" class="form-control" id="searchQuery" name="searchQuery"
                       value="@Model.SearchQuery" placeholder="Enter name to search..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-2"></i>Search
                </button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Results Table -->
<div class="card shadow">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">
            @if (Model.Category == "DOCTOR")
            {
                <i class="fas fa-user-md me-2"></i>
                <text>Doctors</text>
            }
            else if (Model.Category == "PATIENT")
            {
                <i class="fas fa-user-injured me-2"></i>
                <text>Patients</text>
            }
            else
            {
                <i class="fas fa-users me-2"></i>
                <text>Staff Members</text>
            }
        </h5>
    </div>
    <div class="card-body">
        @if (Model.Category == "DOCTOR" && Model.Doctors.Any())
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in Model.Doctors)
                    {
                        <tr>
                            <td>@doctor.DoctorId</td>
                            <td>@doctor.Name</td>
                            <td>@(doctor.Department?.DeptName ?? "N/A")</td>
                            <td>@doctor.Email</td>
                            <td>
                                <form method="post" asp-page-handler="Delete" class="d-inline">
                                    <input type="hidden" name="id" value="@doctor.DoctorId" />
                                    <input type="hidden" name="category" value="DOCTOR" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this doctor?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (Model.Category == "PATIENT" && Model.Patients.Any())
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model.Patients)
                    {
                        <tr>
                            <td>@patient.PatientId</td>
                            <td>@patient.Name</td>
                            <td>@patient.Phone</td>
                            <td>@patient.Email</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (Model.Category == "STAFF" && Model.Staff.Any())
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model.Staff)
                    {
                        <tr>
                            <td>@staff.StaffId</td>
                            <td>@staff.Name</td>
                            <td>@staff.Designation</td>
                            <td>
                                <form method="post" asp-page-handler="Delete" class="d-inline">
                                    <input type="hidden" name="id" value="@staff.StaffId" />
                                    <input type="hidden" name="category" value="STAFF" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this staff member?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted text-center">No records found.</p>
        }
    </div>
</div>
