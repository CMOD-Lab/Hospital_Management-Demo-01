@page
@model ClinicManagement.Web.Pages.Patient.BillsHistoryModel
@{
    ViewData["Title"] = "Bills History";
    Layout = "_PatientLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-file-invoice me-2"></i>Bills History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.Bills.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-warning">
                    <tr>
                        <th>Bill ID</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in Model.Bills)
                    {
                        <tr>
                            <td>@bill.BillId</td>
                            <td>$@bill.Amount.ToString("N2")</td>
                            <td>@bill.BillDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (bill.IsPaid)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Unpaid</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
                <p class="text-muted">No bills history available.</p>
            </div>
        }
    </div>
</div>
