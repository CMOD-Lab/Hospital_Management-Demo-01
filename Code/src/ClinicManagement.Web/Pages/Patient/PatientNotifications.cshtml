@page
@model ClinicManagement.Web.Pages.Patient.PatientNotificationsModel
@{
    ViewData["Title"] = "Notifications";
    Layout = "_PatientLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-bell me-2"></i>Notifications</h2>
        <hr />
    </div>
</div>

@if (Model.Appointment != null)
{
    <div class="card shadow border-success">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="fas fa-check-circle me-2"></i>Appointment Approved!</h5>
        </div>
        <div class="card-body">
            <p class="lead">Your appointment has been approved by the doctor.</p>
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Doctor:</strong> @(Model.Appointment.Doctor?.Name ?? "N/A")</p>
                    <p><strong>Timings:</strong> @Model.Appointment.Timings</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Date:</strong> @Model.Appointment.AppointmentDate.ToString("yyyy-MM-dd")</p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow">
        <div class="card-body text-center py-5">
            <i class="fas fa-bell-slash fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No new notifications</h5>
            <p class="text-muted">You don't have any pending notifications at the moment.</p>
        </div>
    </div>
}
