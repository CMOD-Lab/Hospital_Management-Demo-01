@page
@model ClinicManagement.Web.Pages.Patient.ViewDoctorsModel
@{
    ViewData["Title"] = "View Doctors";
    Layout = "_PatientLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-user-md me-2"></i>View Doctors by Department</h2>
        <hr />
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label for="deptName" class="form-label">Select Department</label>
                <select class="form-select" id="deptName" name="deptName">
                    <option value="">-- Select Department --</option>
                    @foreach (var dept in Model.Departments)
                    {
                        if (Model.SelectedDept == dept.DeptName)
                        {
                            <option value="@dept.DeptName" selected>@dept.DeptName</option>
                        }
                        else
                        {
                            <option value="@dept.DeptName">@dept.DeptName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-2"></i>View Doctors
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Doctors.Any())
{
    <div class="row">
        @foreach (var doctor in Model.Doctors)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-user-md fa-3x text-primary mb-3"></i>
                        <h5>@doctor.Name</h5>
                        <p class="text-muted">@doctor.Specialization</p>
                        <p><strong>Charges:</strong> $@doctor.ChargesPerVisit/visit</p>
                        <p><strong>Experience:</strong> @doctor.Experience years</p>
                        <a href="/Patient/DoctorProfile?doctorId=@doctor.DoctorId" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-eye me-1"></i>View Profile
                        </a>
                        <a href="/Patient/AppointmentTaker?doctorId=@doctor.DoctorId" class="btn btn-primary btn-sm ms-1">
                            <i class="fas fa-calendar-plus me-1"></i>Book Appointment
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(Model.SelectedDept))
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No doctors found in the selected department.
    </div>
}
