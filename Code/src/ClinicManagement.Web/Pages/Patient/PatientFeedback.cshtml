@page
@model ClinicManagement.Web.Pages.Patient.PatientFeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
    Layout = "_PatientLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-star me-2"></i>Patient Feedback</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-info") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.PendingFeedback != null)
{
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="fas fa-star me-2"></i>Pending Feedback</h5>
        </div>
        <div class="card-body">
            <p>You have a pending feedback for your appointment with:</p>
            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Doctor:</strong> @(Model.PendingFeedback.Doctor?.Name ?? "N/A")</p>
                    <p><strong>Timings:</strong> @Model.PendingFeedback.Timings</p>
                </div>
            </div>
            <form method="post">
                <input type="hidden" name="appointmentId" value="@Model.PendingFeedback.AppointmentId" />
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-star me-2"></i>Submit Feedback
                </button>
            </form>
        </div>
    </div>
}
else
{
    <div class="card shadow">
        <div class="card-body text-center py-5">
            <i class="fas fa-star fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No pending feedback</h5>
            <p class="text-muted">You don't have any pending feedback at the moment.</p>
        </div>
    </div>
}
