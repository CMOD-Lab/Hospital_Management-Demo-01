@page
@model ClinicManagement.Web.Pages.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Doctor Profile";
    Layout = "_PatientLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-user-md me-2"></i>Doctor Profile</h2>
        <hr />
    </div>
</div>

@if (Model.Doctor != null)
{
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow text-center">
                <div class="card-body">
                    <i class="fas fa-user-md fa-5x text-primary mb-3"></i>
                    <h4>@Model.Doctor.Name</h4>
                    <p class="text-muted">@Model.Doctor.Specialization</p>
                    <div class="d-flex justify-content-center gap-2">
                        <span class="badge bg-primary">@(Model.Doctor.Department?.DeptName ?? "N/A")</span>
                        <span class="badge bg-success">Active</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Doctor Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Phone:</strong> @Model.Doctor.Phone</p>
                            <p><strong>Gender:</strong> @Model.Doctor.Gender</p>
                            <p><strong>Qualification:</strong> @Model.Doctor.Qualification</p>
                            <p><strong>Experience:</strong> @Model.Doctor.Experience years</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Charges/Visit:</strong> $@Model.Doctor.ChargesPerVisit</p>
                            <p><strong>Repute Index:</strong> @Model.Doctor.ReputeIndex.ToString("F2")</p>
                            <p><strong>Patients Treated:</strong> @Model.Doctor.PatientsTreated</p>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a href="/Patient/AppointmentTaker?doctorId=@Model.Doctor.DoctorId" class="btn btn-primary">
                            <i class="fas fa-calendar-plus me-2"></i>Book Appointment
                        </a>
                        <a href="/Patient/ViewDoctors" class="btn btn-outline-secondary ms-2">
                            <i class="fas fa-arrow-left me-2"></i>Back
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle me-2"></i>Doctor not found.
    </div>
}
