@page
@model ClinicManagement.Web.Pages.Patient.AppointmentTakerModel
@{
    ViewData["Title"] = "Book Appointment";
    Layout = "_PatientLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-calendar-plus me-2"></i>Book Appointment</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Doctor != null)
{
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-user-md me-2"></i>Selected Doctor</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Name:</strong> @Model.Doctor.Name</p>
                    <p><strong>Specialization:</strong> @Model.Doctor.Specialization</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Department:</strong> @(Model.Doctor.Department?.DeptName ?? "N/A")</p>
                    <p><strong>Charges/Visit:</strong> $@Model.Doctor.ChargesPerVisit</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.FreeSlots.Any())
    {
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Available Slots</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" name="doctorId" value="@Model.DoctorId" />
                    <div class="row">
                        @foreach (var slot in Model.FreeSlots)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="form-check card p-3">
                                    <input class="form-check-input" type="radio" name="freeSlotId"
                                           id="slot_@slot.AppointmentId" value="@slot.AppointmentId" required />
                                    <label class="form-check-label" for="slot_@slot.AppointmentId">
                                        <strong>@slot.Timings</strong>
                                        <br /><small class="text-muted">@slot.AppointmentDate.ToString("yyyy-MM-dd")</small>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-calendar-check me-2"></i>Book Selected Slot
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>No available slots for this doctor at the moment.
        </div>
    }
}
else
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle me-2"></i>Doctor not found.
    </div>
}
